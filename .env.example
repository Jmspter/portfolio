# Cópia para .env em desenvolvimento. Em produção, configure no painel do Pages.
# Chaves de teste do Turnstile (sempre passam):
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NUXT_TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Deixe vazio em dev: o e-mail é apenas logado no console.
NUXT_RESEND_API_KEY=
NUXT_CONTACT_TO=voce@exemplo.com
NUXT_CONTACT_FROM="Portfolio <contato@seudominio.com>"

# Cloudflare Access (só produção; em dev o /admin fica liberado)
NUXT_ACCESS_TEAM_DOMAIN=
NUXT_ACCESS_AUD=

NUXT_VISITOR_SALT=troque-por-uma-string-aleatoria
NUXT_PUBLIC_SITE_URL=http://localhost:3000
